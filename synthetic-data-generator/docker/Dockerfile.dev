# Development Dockerfile with hot-reload and debugging tools
FROM rust:1.82-slim-bookworm

# Install development dependencies with version pinning
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    build-essential \
    git \
    curl \
    vim \
    htop \
    procps \
    gdb \
    strace \
    valgrind \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install Rust development tools (essential tools only)
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH
RUN rustup component add clippy rustfmt \
    && cargo install --locked cargo-watch --version 8.4.1 \
    && echo "Development tools installed successfully"

# Create workspace directory first
WORKDIR /workspace

# Create non-root user for development
RUN useradd -m -u 1001 -s /bin/bash dev \
    && chown -R dev:dev /workspace \
    && chown -R dev:dev /usr/local/cargo

# Create workspace directory with correct permissions
RUN mkdir -p target && chown -R dev:dev target

# Switch to non-root user for development
USER dev

# Set development environment variables
ENV RUST_LOG=debug
ENV RUST_BACKTRACE=1
ENV CARGO_INCREMENTAL=1
ENV CARGO_NET_RETRY=10
ENV RUSTUP_MAX_RETRIES=10

# Create cache directories
RUN mkdir -p /home/dev/.cargo/registry \
    && mkdir -p /home/dev/.cargo/git

# Expose ports for future services
EXPOSE 8080 9090

# Health check for development
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["cargo", "--version"]

# Development command (can be overridden)
CMD ["cargo", "watch", "-x", "check --workspace"]