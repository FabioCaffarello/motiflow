# Alternative production Dockerfile using standard Debian base
# Use this if distroless image causes issues
FROM rust:1.82-slim-bookworm AS builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy manifests
COPY Cargo.toml ./
COPY core/Cargo.toml ./core/
COPY infrastructure/Cargo.toml ./infrastructure/
COPY application/Cargo.toml ./application/
COPY cli/Cargo.toml ./cli/

# Create dummy source files
RUN mkdir -p core/src infrastructure/src application/src cli/src \
    && echo "fn main() {}" > core/src/lib.rs \
    && echo "fn main() {}" > infrastructure/src/lib.rs \
    && echo "fn main() {}" > application/src/lib.rs \
    && echo "fn main() {}" > cli/src/main.rs

# Build dependencies
RUN cargo build --release --workspace

# Copy source and rebuild
COPY . .
RUN touch core/src/lib.rs infrastructure/src/lib.rs application/src/lib.rs cli/src/main.rs
RUN cargo build --release --workspace

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1001 app

COPY --from=builder /app/target/release/syngen /usr/local/bin/syngen
RUN chmod +x /usr/local/bin/syngen

USER app
ENTRYPOINT ["/usr/local/bin/syngen"]
CMD ["--help"]